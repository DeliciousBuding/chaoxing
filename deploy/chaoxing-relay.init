#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

# Reverse SSH relay used in production. The edge host terminates TLS and
# forwards to the loopback HTTP listener through RemoteForward in
# /etc/chaoxing/relay.ssh.conf. This file intentionally contains no host,
# user, port or key path from the deployed environment.
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ssh -F /etc/chaoxing/relay.ssh.conf -NT chaoxing-edge
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="64 64"
    procd_close_instance
}

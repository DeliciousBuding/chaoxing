#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/local/bin/cloudflared-chaoxing --no-autoupdate tunnel --protocol http2 --edge-ip-version 4 --ha-connections 1 run --token-file /etc/chaoxing/tunnel.token
    procd_set_param env GOMEMLIMIT=64MiB GOGC=50 GOMAXPROCS=2
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="256 256"
    procd_close_instance
}
